# ==========================================
# Tokyo Hybrid Graph RAG Environment Config
# ==========================================

# 1. API LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
# Alternative models: qwen2.5:3b, gemma2:2b, scb10x/llama3.1-typhoon2-8b-instruct:latest

# 3. Knowledge Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# 4. Vector Stores & Embeddings
EMBED_MODEL=BAAI/bge-m3
# Alternative models: intfloat/multilingual-e5-base, sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEVICE=cpu
FAISS_PATH=data/faiss_index
CHROMA_PATH=data/chroma_db
BM25_PATH=data/bm25_index
