# ==========================================
# Tokyo Hybrid Graph RAG Environment Config
# ==========================================

# 1. API LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Local LLM (Ollama 3B/4B)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b
# Supported 3B-4B models: qwen2.5:3b, gemma3:4b, hf.co/typhoon-ai/typhoon2.1-gemma3-4b-gguf:Q4_K_M, qwen3.5:4b

# 3. Knowledge Graph Database (Neo4j)
# Local server example: bolt://localhost:7687
# Aura example: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# 4. Vector Stores & Embeddings
EMBED_MODEL=BAAI/bge-m3
# Alternative models: intfloat/multilingual-e5-base, sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEVICE=cpu
FAISS_PATH=data/faiss_index
CHROMA_PATH=data/chroma_db
BM25_PATH=data/bm25_index

# 5. LINE Messaging API & Chatbot
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
CHANNEL_SECRET=your_line_channel_secret_here

